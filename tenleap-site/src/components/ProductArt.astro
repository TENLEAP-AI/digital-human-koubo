---
// 占位产品插画（纯 SVG）。有实拍图后在 ProductCard / 详情页换成 <img>。
interface Props { kind: 'watch' | 'band' | 'voice'; hue: string; size?: number }
const { kind, hue, size = 320 } = Astro.props;
const id = `g-${kind}-${Math.random().toString(36).slice(2, 7)}`;
---
<svg viewBox="0 0 320 320" width={size} height={size} role="img" aria-label={`${kind} illustration`}>
  <defs>
    <radialGradient id={id} cx="50%" cy="45%" r="60%">
      <stop offset="0%" stop-color={hue} stop-opacity="0.35" />
      <stop offset="100%" stop-color={hue} stop-opacity="0" />
    </radialGradient>
  </defs>
  <circle cx="160" cy="160" r="150" fill={`url(#${id})`} />
  {kind === 'watch' && (
    <g>
      <rect x="118" y="20" width="84" height="90" rx="20" fill="#232733" />
      <rect x="118" y="210" width="84" height="90" rx="20" fill="#232733" />
      <circle cx="160" cy="160" r="78" fill="#2a2f3b" />
      <circle cx="160" cy="160" r="68" fill="#050608" />
      <circle cx="160" cy="160" r="52" fill="none" stroke="#1d212a" stroke-width="10" />
      <circle cx="160" cy="160" r="52" fill="none" stroke={hue} stroke-width="10" stroke-linecap="round"
        stroke-dasharray="230 400" transform="rotate(-90 160 160)" />
      <text x="160" y="158" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="28" font-weight="700" fill="#f5f5f0">10:24</text>
      <text x="160" y="182" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill={hue}>READY 86</text>
      <rect x="236" y="146" width="10" height="28" rx="4" fill="#3a3f4c" />
    </g>
  )}
  {kind === 'band' && (
    <g>
      <path d="M60 196 C 60 90, 260 90, 260 196" fill="none" stroke="#232733" stroke-width="44" stroke-linecap="round" />
      <rect x="112" y="128" width="96" height="58" rx="22" fill="#2a2f3b" transform="rotate(-6 160 157)" />
      <rect x="120" y="135" width="80" height="44" rx="16" fill="#050608" transform="rotate(-6 160 157)" />
      <g transform="rotate(-6 160 157)">
        <text x="160" y="160" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="18" font-weight="700" fill="#f5f5f0">7h 42m</text>
        <rect x="134" y="166" width="52" height="5" rx="2.5" fill={hue} />
      </g>
    </g>
  )}
  {kind === 'voice' && (
    <g>
      <rect x="110" y="70" width="100" height="160" rx="50" fill="#2a2f3b" />
      <rect x="120" y="80" width="80" height="140" rx="40" fill="#050608" />
      {[0, 1, 2, 3, 4].map((i) => {
        const h = [18, 40, 60, 40, 18][i];
        return <rect x={134 + i * 11} y={150 - h / 2} width="6" height={h} rx="3" fill={hue} />;
      })}
      <rect x="146" y="238" width="28" height="40" rx="8" fill="#232733" />
    </g>
  )}
</svg>
